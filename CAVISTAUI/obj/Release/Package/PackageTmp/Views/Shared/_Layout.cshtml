                                                                }
                                                                else
                                                                {
                                                <li>
                                                    <a href="javascript:void(0)" id="hrefbakup" class="dropdown" style="font-weight: bold;">Backup</a>
                                                </li>
                                                                }
                                                            }
                                                        }
                                                    }
                                                    </ul>
                                            </li>
                                        }
                                    }
                                    @*<li> @Html.ActionLink("All Reports", "index", "Reports", new { name = "Reports", strFormID = 0 }, new { @class = "dropdown", @style = "font-weight:bold;color:white;padding-left:15px;padding-right:10px", @title = User, @target = "_black" })</li>*@
                                    <li>@Html.ActionLink("LogOut - " + User, "LogOff", "Login", null, new { @class = "dropdown", @style = "font-weight:bold;", @title = User })</li>
                                </ul>
                            </div>
                        </div>
                    </nav>
                </div>
            </div>
        }
    }
