    <script src="~/Scripts/Validation.js"></script>
    <script src="~/Scripts/flatpickr.js"></script>
    <div style="padding:10px">
        <div class="toastBox"></div>
        <script>
            var ClosecfFocus = 2, ClearcfFocus = 2, cfFocus = 1;
            const flatpickrInstances = {};
            function InitializeDateField(WithDateTime, className) {
                document.querySelectorAll(className).forEach(function (input) {
                    const id = input.id;
                    flatpickrInstances[id] = flatpickr(input, {
                        enableTime: WithDateTime == 1,
                        dateFormat: WithDateTime == 0 ? "d/M/Y" : "d/M/Y H:i", // Internal format with datetime "d M Y H:i",
                        altInput: true,
                        altFormat: WithDateTime == 0 ? "d/M/Y" : "d/M/Y H:i",  // Display format in input
                        allowInput: false,
                        time_24hr: false,
                    });
                });
            }
            // Disable auto width for all DataTables by default
            $.extend(true, $.fn.dataTable.defaults, {
                autoWidth: false
            })
            let sb = document.getElementById("RepLoadersnackbar");
        </script>
