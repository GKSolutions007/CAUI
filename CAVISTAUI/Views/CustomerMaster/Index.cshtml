    //GetData(7, RID,0);
    function GetData(nMode,strName,DepID = 0) {
        $.ajax({
            url: Aurl + "customer/get",
            type: 'get',
            contentType: 'json',
            data: {Mode: nMode, ID: strName },
            success: function (data) {
                if (nMode == 1) {
                    console.log("data ", eval(data));
                    var response = eval(data);
                    var Constlist = eval(response[0]);
                    var Statelist = eval(response[1]);
                    $('#cmbConstitution,#cmbStateName').find("option").remove();
                    $('#cmbConstitution,#cmbStateName').append($('<option/>', {
                        value: 0,
                        text: "-- Select --",
                        class: ""
                    }));
                    $.each(Constlist, function (i, items) {
                        $('#cmbConstitution').append($('<option/>', {
                            value: items.ID,
                            text: items.Name,
                        }));
                    });
                    $.each(Statelist, function (i, items) {
                        $('#cmbStateName').append($('<option/>', {
                            value: items.StateID,
                            text: items.StateName,
                        }));
                    });
                }
                else if (nMode == 2) {
                    var arrUsersData = [];
                    //Table.draw().clear();
                    if (data.length > 0) {
                        arrUsersData = eval(data)
                        $.each(arrUsersData, function (i, items) {
                            //arrData[i] = items.UserName;
                            var al = {
                                "label": items.UserName,
                                "id": items.ID,
                            }
                            arrData.push(al);
                        });
                        console.log("arrUsersData : ", arrUsersData);
                        grid = new GKBSDynamicGrid('#my-grid', columns, arrUsersData, {
                            enablePagination: true,
                            pageSize: 10,
                            enableSearch: true,
                            stickyToWindow: true,
                            enableExport: false,
                            enablePrint: false,
                            enableColumnsBtn: true,
                            enableAddRow: false,
                            enableRemoveRow: false,
                            enableSorting: true,
                            singleIconAction: singleIconAction,
                            rowActionsMenu: menuActions,
                            //onCellChange: handleCellUpdate,
                        });
                    }
                    else {
                        showErrorSnackbar("No Records Found");
                    }
                }
                else if (nMode == 3) {
                    var attachemtlist = [];
