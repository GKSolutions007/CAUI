                    if (confirm(`Are you sure you want to delete file ${rowData.fileName}?`)) {
                        var FileName = rowData.fileName;//[0];
                        var FilePath = rowData.fullPath;//[0];
                        deletefiles(FilePath, FileName, gridInstance, rowData);
