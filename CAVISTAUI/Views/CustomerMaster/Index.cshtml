    function SaveData() {
        $("#btnSave").prop("disabled", true);
        $(".clrdiv").html("");
        var lstMaster = {
            Mode: nMode,
            ID: $("#txtID").val(),
            CustomerCode: $('#txtCode').val(),
            CustomerGroupCode: $("#rdoTaxAudit").is(":checked") ? 1 : 2,
            FirstName: $('#txtFirstName').val(),
            FatherName: $('#txtFatherName').val(),
            Constitution: $('#cmbConstitution').val(),
            NameofBusiness: $('#txtBusinessName').val(),
            BusinessPanno: $('#txtBusinessPANNO').val(),
            GSTNo: $('#txtGSTIN').val(),
            PANno: $('#txtPanno').val(),
            DateRegorIncorp: $('#txtDateRegIncorp').val(),
            DOB: $('#txtDOB').val(),
            AccountManage: $('#txtAccountManager').val(),

            ITUserName: $('#txtITUserName').val(),
            ITPassword: $('#txtITPassword').val(),
            ITFileNo: $('#txtITFileNo').val(),
            ITRegEmailID: $('#txtITRegEmail').val(),
            ITRegContactNo: $('#txtITRegContactNo').val(),

            GSTFileNo: $('#txtGSTFileNo').val(),
            GSTUserName: $('#txtGSTUserName').val(),
            GSTPassword: $('#txtGSTPassword').val(),
            GSTRegDate: $('#txtGSTRegDate').val(),
            GSTRegType: $('#txtGSTRegType').val(),
            DateofOPT: $('#txtGSTDateofOPT').val(),
            GSTRegEmailID: $('#txtGSTRegEmail').val(),
            GSTRegContactNo: $('#txtGSTRegContactNo').val(),

            MobileNo: $('#txtCPMobileNo').val(),
            AddMobileNo: $('#txtCPAdditionalMobileNo').val(),
            EmailID: $('#txtCPEmail').val(),
            AddEmailID: $('#txtCPAdditionalEmail').val(),
            LLIPINno: $('#txLLIPINNo').val(),
            TANNo: $('#txTANNo').val(),
            CINNo: $('#txtCINNo').val(),
            DINNo: $('#txDINNo').val(),
            Address: $('#txtAddress').val(),
            City: $('#txtCity').val(),
            State: $('#cmbStateName').val(),
            Country: $('#txtCountry').val(),
            Pincode: $('#txtPincode').val(),
            Active: $("#chkActive").is(":checked") ? 1 : 0,
            Cby: UID
        };
        // Create FormData
        var formData = new FormData();

        // Add JSON object as a string
        formData.append("model", JSON.stringify(lstMaster));

        // Add attachment file
        //var file = $("#txtAttachments")[0].files[0];
        //if (file) {
        //    formData.append("file", file);
        //}
        var fileUpload = $("#txtAttachments").get(0);
        var files = fileUpload.files;
        // Create FormData object
        // Looping over all files and add it to FormData object
        for (var i = 0; i < files.length; i++) {
            formData.append("Customer", files[i]);
        }

            $.ajax({
                url: Aurl + "customer/save",
                type: 'POST',
                //contentType: 'application/json; charset=utf-8',
                //data: JSON.stringify(lstMaster),
                data: formData,
                contentType: false,     // IMPORTANT
                cache: false,
                processData: false,
                success: function (data) {
                    $("#btnSave").prop("disabled", false);
                    $.each(data, function (i, items) {
                        if (items.MsgID == 0) {
                            showSuccessSnackbar(items.Message);
                            ClearForm();
                            GetData(2, 0);
                            modal.style.display = "none";
                        }
                        else {
                            showErrorSnackbar(items.Message);
                        }
                    });
                }, error: function (data) {
                    $("#btnSave").prop("disabled", false);
                    if (data.status == "401") {
                        var msg = data.responseJSON.Message;
                        //showErrorSnackbar(msg + " Logout and Login again.");
                    }
                }
            });
    }
    function deletefiles(strFilePth, strFileName, gridInstance, rowData) {
        $.ajax({
            url: Aurl + "customer/deletemyuploadfile",
            type: 'get',
            contentType: 'json',
            data: { FPath: strFilePth, FName: strFileName },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                $.each(data, function (i, items) {
                    if (items.MsgID == "1") {
                        showSuccessSnackbar(items.Message);
                        //GetData(2);
                        gridInstance.deleteRow(rowData._gridId);
                    }
                    else if (items.MsgID == "2") {
                        showErrorSnackbar(items.Message);
                    }
                });
            }, error: function (data) {
                showErrorSnackbar("Error : " + data);
            }
        });
    }
</script>
