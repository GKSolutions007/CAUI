@model CAVISTAUI.Models.SingleMasterModel

@{
    ViewBag.Title = "Users";
}
@*<script src="~/Scripts/jquery-3.7.1.js"></script>*@
<link href="~/GKBSGrid/css/gridui.css" rel="stylesheet" />
<script src="~/GKBSGrid/js/gridui.js"></script>
<style>
    td {
        font-size: 11px;
    }

    input[type=number] {
        text-align: right;
    }

        input[type=number]::placeholder {
            text-align: left;
        }
    /* Chrome, Safari, Edge, Opera */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* Firefox */
    input[type=number] {
        -moz-appearance: textfield;
    }
    /* The Modal (background) */
    .modalBatch {
        display: none; /* Hidden by default */
        position: fixed; /* Stay in place */
        z-index: 10000; /* Sit on top */
        left: 0;
        top: 0;
        width: 100%; /* Full width */
        height: 100%; /* Full height */
        overflow: auto; /* Enable scroll if needed */
        background-color: rgb(0,0,0); /* Fallback color */
        background-color: rgba(0,0,0,0.4); /* Black w/ opacity */
    }

    /* Modal Content/Box */
    @@media only screen and (min-width: 600px) {
        .modalBatch-content {
            background-color: #ffffff;
            margin: 3% auto; /* 15% from the top and centered */
            padding: 2px;
            border: 1px solid #888;
            width: 25%; /* Could be more or less, depending on screen size */
            height: 70%;
            top: 5%;
            overflow: auto;
        }
    }

    @@media only screen and (max-width: 600px) {
        .modalBatch-content {
            background-color: #ffffff;
            margin: 10% auto; /* 15% from the top and centered */
            padding: 3px;
            border: 1px solid #888;
            width: 95%; /* Could be more or less, depending on screen size */
            height: 80%;
            top: 20%;
            overflow: auto;
        }
    }
    /* The Close Button */
    .closefg {
        color: #aaa;
        float: right;
        font-size: 10px;
        font-weight: bold;
    }

        .closefg:hover,
        .closefg:focus {
            color: black;
            text-decoration: none;
            cursor: pointer;
        }

    .form-label {
        position: relative;
        display: block;
        clear: both;
        max-width: 500px;
        margin: 0 auto;
    }

    .labelup {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -40%;
        left: 1em;
        background: #fffefe;
        color: #2b2828;
        font-size: 0.90em;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
        font-weight:700;
    }
</style>
<body>

    @Html.HiddenFor(model => model.Add, new { @autocomplete = "off", @class = "form-control", @id = "txtAddID" })
    @Html.HiddenFor(model => model.Modify, new { @autocomplete = "off", @class = "form-control", @id = "txtModifyID" })
    @Html.HiddenFor(model => model.View, new { @autocomplete = "off", @class = "form-control", @id = "txtViewID" })
    @Html.HiddenFor(model => model.FormName, new { @autocomplete = "off", @class = "form-control", @id = "txtFormName" })
    @Html.HiddenFor(model => model.ID, new { @autocomplete = "off", @class = "form-control FormclrField", @id = "txtID" })
    <h4 id="MainHeading">@ViewData["FormName"]</h4>
    <hr />
    <div class="toastBox"></div>
    <div style="padding-bottom:10px;float:right">
        <button id="btnAdd" class="btn btn-info"><span class="glyphicon glyphicon-plus" style="color: white"></span>&#x2009;Add New</button>
    </div>
    <div id="my-grid" style="height: 500px; width: 100%;"></div>
    <div class="modalBatch" id="myModalfg">
        <div class="modal-dialog" style="width:auto;">
            <div class="modalBatch-content">
                <!-- Modal Header -->
                <div class="modal-header" style="background-color:bisque">
                    <button type="button" class="closefg">&times;</button>
                    <h5 class="modal-title" style="color:black" id="lblPopupheading"><b>User</b></h5>
                    @*<hr />*@
                </div>
                <!-- Modal body -->
                <div class="modal-body" align="center">
                    <div align="center">
                        <div id="dvAssign" style="width:100%;padding-bottom:7px">
                            <table class="table" style="width:100%">

                                <tr>
                                    <td style="border:none;padding-left:12px;padding-right:7px" colspan="2">
                                        <span class="form-label">
                                            <input tabindex="1" type="text" id="txtUserName" class="form-control FormclrField" placeholder="" />
                                            <label class="labelup">Name *</label>
                                        </span>
                                        <div class="clrdiv" id="dvErrorUserName" style="color:red"></div>
                                    </td>
                                </tr>                              
                                <tr>
                                    <td align="right" style="border:none" width="40%">
                                        <label for="chkActive">Active :</label>
                                    </td>
                                    <td style="border:none">
                                        <input tabindex="6" type="checkbox" id="chkActive" checked disabled />
                                        <div class="clrdiv" id="dvErrorActive" style="color:red"></div>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
                <!-- Modal footer -->
                <div class="modal-footer" style="background-color:skyblue">
                    <div style="padding-top:5px" align="right">
                        <button tabindex="8" type="button" class="btn btn-danger" id="btnClear"><span class="glyphicon glyphicon-refresh"> Clear</span></button>
                        <button tabindex="7" type="button" class="btn btn-success" id="btnSave"><span class="glyphicon glyphicon-saved"> Save</span></button>
                        <button tabindex="9" type="button" class="btn btn-warning" id="btnClose"><span class="glyphicon glyphicon-remove"> Close</span></button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
<script type="text/javascript">
    var Aurl = '@Session["APIurl"]';
    if ($("#txtAddID").val() == 0) {
        $("#trAdd").hide();
        $("#btnAdd").hide();
    }
    var EnableEdit = true, EnableView = true;
    if ($("#txtModifyID").val() == 0) {
        //Table.column(8).visible(false);
        EnableEdit = false;
    }
    if ($("#txtViewID").val() == 0) {
        //Table.column(9).visible(false);
        EnableView = false;
    }
    if ($("#txtModifyID").val() == 0 && $("#txtViewID").val() == 0 && $("#txtAddID").val() == 1) {
        $("#my-grid").hide();
    }
    const data = [];
    var ActionVisible = (!EnableEdit && !EnableView);
    const columns = [
        { field: 'ID', header: 'ID', type: 'label', width: 20, align: 'left', visible: false, EnableColumnMenu: false ,ShowinColumnOption : false},
        { field: 'UserName', header: 'Name', type: 'label', width: 200, align: 'left', visible: true, EnableColumnMenu: true, ShowinColumnOption: true },
        { field: 'Active', header: 'Active', type: 'label', width: 100, align: 'left', visible: true, EnableColumnMenu: true, ShowinColumnOption: true },
        { field: 'User', header: 'User', type: 'label', width: 150, align: 'left', visible: true, EnableColumnMenu: true, ShowinColumnOption: true },
        { header: 'Action', type: 'action3dots', width: 80, align: 'center', visible: !ActionVisible, specialColumn: true, ShowinColumnOption: false },
    ];
    const allGridActions = [
        {
            icon: '👁️',
            title: 'View Details',
            className: 'dg-action-view',
            // 💡 NEW TAG: This action will be rendered as a single icon
            displayType: 'menu_item',
            visible: EnableView,
            handler: (rowData) => {
                nMode = 3;
                $(".clrdiv").html("");
                $("#lblPopupheading").text("View Role");
                var ID = rowData.ID;//[0];
                GetData(5, ID);
                $(".FormclrField").prop("disabled", true);
                $("#chkActive,#btnSave,#btnClear,#cmbRole").prop("disabled", true);
                modal.style.display = "block";

            }
        },
        {
            icon: '📝',
            title: 'Edit Details',
            className: 'dg-action-pencil',
            // 💡 NEW TAG: This action will be rendered as a single icon
            displayType: 'menu_item',
            visible: EnableEdit,
            handler: (rowData) => {
                $(".clrdiv").html("");
                nMode = 2;
                $("#lblPopupheading").text("Edit Role");
                var ID = rowData.ID;//[0];
                GetData(5, ID);
                $(".FormclrField").prop("disabled", false);
                $("#chkActive,#btnSave,#cmbRole").prop("disabled", false);
                $("#btnClear").prop("disabled", true);
                modal.style.display = "block";
            }
        },
    ];

    // Split the actions for easy use in renderBody and showRowActionsMenu
    const singleIconAction = allGridActions.find(a => a.displayType === 'single_icon' && a.visible == true);
    const menuActions = allGridActions.filter(a => a.displayType === 'menu_item' && a.visible == true);

    var grid = new GKBSDynamicGrid('#my-grid', columns, data, {
        enablePagination: true,
        pageSize: 10,
        enableSearch: true,
        stickyToWindow: true,
        enableExport: false,
        enablePrint: false,
        enableColumnsBtn: true,  // Controls the '⚙️ Columns' button (Assuming you want to rename enableColumnVisibility)
        enableAddRow: false,      // 💡 NEW: Controls '➕ Add Row'
        enableRemoveRow: false,   // 💡 NEW: Controls '➖ Remove Selected'
        enableSorting: true,
        singleIconAction: singleIconAction, // Pass the single View action
        rowActionsMenu: menuActions,       // Pass the Delete/Print actions
        //onCellChange: handleCellUpdate,
    });
    var arrData = [];
    var UID = '@Session["LoginUserID"]';
    var RID = '@Session["RoleID"]';
    var nMode = 1;
    GetData(6, "");
    GetData(7, RID,0);
    function GetData(nMode,strName,DepID = 0) {
        $.ajax({
            url: Aurl + "signup/get",
            type: 'get',
            contentType: 'json',
            data: {Mode: nMode, Name: strName },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                if (nMode == 6) {
                    arrData = [];
                    var arrUsersData = [];
                    //Table.draw().clear();
                    if (data.length > 0) {
                        arrUsersData = eval(data)
                        $.each(arrUsersData, function (i, items) {
                            //arrData[i] = items.UserName;
                            var al = {
                                "label": items.UserName,
                                "id": items.ID,
                            }
                            arrData.push(al);
                        });
                        console.log("arrUsersData : ", arrUsersData);
                        grid = new GKBSDynamicGrid('#my-grid', columns, arrUsersData, {
                            enablePagination: true,
                            pageSize: 10,
                            enableSearch: true,
                            stickyToWindow: true,
                            enableExport: false,
                            enablePrint: false,
                            enableColumnsBtn: true,
                            enableAddRow: false,
                            enableRemoveRow: false,
                            enableSorting: true,
                            singleIconAction: singleIconAction,
                            rowActionsMenu: menuActions,
                            //onCellChange: handleCellUpdate,
                        });
                    }
                    else {
                        showErrorSnackbar("No Records Found");
                    }
                }
                else if (nMode == 5) {
                    $.each(eval(data), function (i, items) {
                        console.log("User info ", items)
                        $("#txtID").val(items.ID);
                        $("#txtUserName").val(items.UserName);
                        $("#txtUserID").val(items.UserID);
                        $("#txtMobileNo").val(items.Mobilenumber);
                        $("#txtPassword").val(items.Password);
                        $("#txtEMail").val(items.EMailID);
                        $("#cmbRole").val(items.RoleID);
                        $("#chkActive").prop("checked", items.Active);
                    });
                }
                else if (nMode == 7) {
                    $('#cmbRole').find("option").remove();
                    $('#cmbRole').append($('<option/>', {
                        value: 0,
                        text: "-- Select Role --",
                        class: ""
                    }));
                    $.each(eval(data), function (i, items) {
                        $('#cmbRole').append($('<option/>', {
                            value: items.ID,
                            text: items.Name,
                        }));
                    });
                    $('#cmbRole').val(DepID);
                }

            }, error: function (data) {
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    //showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }
    function displayResult(item) {
        $('.alert').show().html('You selected <strong>' + item.value + '</strong>: <strong>' + item.text + '</strong>');
    }

    var modal = document.getElementById("myModalfg");
    var span = document.getElementsByClassName("closefg")[0];
    span.onclick = function () {
        modal.style.display = "none";
    }
    function CloseForm() {
        modal.style.display = "none";
    }

    $('#btnClose').click(function (e) {
        //if (ClosecfFocus != 3) { CloseConfirmDialogMsg("Do you want to close?"); } else { CloseForm(); }
        CloseForm();
    });

    $("#btnAdd").click(function () {
        nMode = 1;
        $("#chkActive,#btnSave,#cmbRole,#btnClear,.FormclrField").prop("disabled", false);
        $("#lblPopupheading").text("Add Role");
        modal.style.display = "block";
        ClearForm();
    });
    $('#btnClear').click(function (e) {
        //if (cfFocus != 3) { ClearConfirmDialogMsg("Do you want to clear?"); } else { ClearForm(); }
        ClearForm();
    });
    function ClearForm() {
        $(".FormclrField").val("");
        $(".FormclrcmbField").val(0);
        $("#chkActive").prop("checked", true);
        $("#chkActive").prop("disabled", nMode != 2);
        $(".clrdiv").html("");
        $("#cmbRole").val();
        $("#txtUserID").focus();
        if (nMode != 1)
            modal.style.display = "none";
    }
    $("#btnSave").click(function () {
        $(".clrdiv").html("");
        var IsValid = true, ChkFormation = true;
        if ($("#txtUserID").val() == "") {
            IsValid = false;
            $("#dvErrorUserID").html("User ID should not be empty");
            showErrorSnackbar("User ID should not be empty");
        }
        if ($("#txtUserName").val() == "") {
            IsValid = false;
            $("#dvErrorUserName").html("Name should not be empty");
            showErrorSnackbar("Name should not be empty");
        }
        if (IsValid) {
            //if (cfFocus != 3) { ConfirmDialogMsg("Do you want to save data?"); } else { SaveData(); }
            SaveData();
        }
    });

    function SaveData() {
        $("#btnSave").prop("disabled", true);
        $(".clrdiv").html("");
        var lstMaster = {
            "Mode": nMode,
            "ID": $("#txtID").val(),
            "UserID": $("#txtUserID").val(),
            "UserName": $("#txtUserName").val(),
            "Password": $("#txtPassword").val(),
            "RoleID": $("#cmbRole").val(),
            "Mobilenumber": $("#txtMobileNo").val(),
            "EMailID": $("#txtEMail").val(),
            "Active": $("#chkActive").is(":checked") ? 1 : 0,
            "LoginUserID": UID
        };        
            $.ajax({
                url: Aurl + "signup/save",
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify(lstMaster),
                cache: false,
                processData: false,
                success: function (data) {
                    $("#btnSave").prop("disabled", false);
                    $.each(data, function (i, items) {
                        if (items.MsgID == 0) {
                            showSuccessSnackbar(items.Message);
                            ClearForm();
                            GetData(6, "");
                            modal.style.display = "none";
                        }
                        else {
                            showErrorSnackbar(items.Message);
                        }                        
                    });
                }, error: function (data) {
                    $("#btnSave").prop("disabled", false);
                    if (data.status == "401") {
                        var msg = data.responseJSON.Message;
                        //showErrorSnackbar(msg + " Logout and Login again.");
                    }
                }
            });
    }
</script>
